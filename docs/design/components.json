{
  "AppHeader": {
    "height": "64px",
    "background": "#FFFFFF",
    "borderBottom": "1px solid #E2E8F0",
    "titleColor": "#0F172A",
    "logo": "3D/Vector House icon with blue roof, red walls and green chimney"
  },
  "BottomNavigation": {
    "height": "72px",
    "background": "#FFFFFF",
    "borderTop": "1px solid #E2E8F0",
    "activeColor": "#4F46E5",
    "inactiveColor": "#64748B",
    "fabButton": {
      "size": "56px",
      "background": "#10B981",
      "iconColor": "#FFFFFF"
    }
  },
  "Card": {
    "background": "#FFFFFF",
    "border": "1px solid #E2E8F0",
    "borderRadius": "24px",
    "padding": "20px",
    "shadow": "0 4px 20px -2px rgba(15, 23, 42, 0.05)"
  },
  "ActionButtonCard": {
    "borderRadius": "20px",
    "borderWidth": "1px",
    "padding": "16px",
    "variants": {
      "stipendio": { "bg": "#ECFDF5", "border": "#A7F3D0", "text": "#059669" },
      "speseFisse": { "bg": "#EFF6FF", "border": "#BFDBFE", "text": "#2563EB" },
      "alimentari": { "bg": "#FFFBEB", "border": "#FDE68A", "text": "#D97706" },
      "casa": { "bg": "#F5F3FF", "border": "#DDD6FE", "text": "#7C3AED" },
      "varie": { "bg": "#FEF2F2", "border": "#FECDD3", "text": "#DC2626" }
    }
  },
  "Badge": {
    "borderRadius": "9999px",
    "padding": "4px 12px",
    "fontSize": "12px",
    "fontWeight": "600"
  },
  "Button": {
    "height": "44px",
    "borderRadius": "12px",
    "padding": "0 20px",
    "fontWeight": "600",
    "primaryBg": "#4F46E5",
    "primaryText": "#FFFFFF"
  }
}
